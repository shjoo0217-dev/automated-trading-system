            "null"
          ],
          "description": "ticker"
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "file_sha256"
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "description": "target_price/reference_price/reported_upside/investment_horizon/multiple 등"
        },
        "raw_value": {
          "type": [
            "string",
            "null"
          ],
          "description": "raw_value"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "정규화 값; 감사 2행은 목표주가 KRW"
        },
        "raw_unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "raw_unit"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "unit"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "description": "page"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
