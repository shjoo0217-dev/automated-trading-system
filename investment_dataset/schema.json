{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:star:investment-dataset:0.1.0",
  "title": "STAR dataset record contracts",
  "description": "Validate records using the named $defs; CSV blank means null. Arrow schemas enforce Parquet dtypes.",
  "$defs": {
    "report": {
      "type": "object",
      "properties": {
        "report_id": {
          "type": "string",
          "description": "source-scoped 게시물 고정 ID; 예: star-340"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "게시물 원제목"
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "표시명; 조인 키로 사용 금지"
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{6}$",
          "description": "6자리 종목코드; 앞자리 0 보존"
        },
        "market": {
          "type": [
            "string",
            "null"
          ],
          "description": "KOSPI/KOSDAQ/KONEX 등; 미확인 null"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "보고서 기재 발간일 또는 게시물 제목 발간일; source 필드로 구별"
        },
        "publication_date_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "발간일의 근거"
        },
        "posted_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "홈페이지 게시일; YYYY-MM-DD"
        },
        "posted_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "홈페이지 게시시각; 미표시 null"
        },
        "first_collected_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "최초 메타데이터 수집 UTC 시각"
        },
        "last_checked_at": {
          "type": [
            "string",
            "null"
