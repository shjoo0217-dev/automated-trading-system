        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "unit"
        },
        "consolidation": {
          "type": [
            "string",
            "null"
          ],
          "description": "연결/별도/미확인 null"
        },
        "business_segment": {
          "type": [
            "string",
            "null"
          ],
          "description": "사업부; 미확인 null"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "description": "PDF 물리적 페이지 1부터"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "원문 첨부 URL"
        },
        "formula": {
          "type": [
            "string",
            "null"
          ],
          "description": "계산값의 계산식; 직접 추출값 null"
        },
        "input_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "input_evidence_ids"
        },
        "quality_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "quality_status"
        },
        "training_eligible": {
          "type": "boolean",
          "description": "training_eligible"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "valuation": {
      "type": "object",
      "properties": {
