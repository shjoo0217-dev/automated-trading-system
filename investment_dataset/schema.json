        },
        "training_eligible": {
          "type": "boolean",
          "description": "학습 허용 여부"
        },
        "split": {
          "type": "string",
          "description": "train/validation/test/excluded"
        },
        "record_kind": {
          "type": [
            "string",
            "null"
          ],
