          "description": "게시글 메타데이터 최종 확인 UTC 시각"
        },
        "modified_detected_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "메타데이터 변경을 처음 발견한 시각; 서버 수정시각과 다름"
        },
        "version_first_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "현재 메타데이터 버전 최초 관측 UTC 시각"
        },
        "available_not_before": {
          "type": [
            "string",
            "null"
          ],
          "description": "입력 사용시점 하한. 원문 버전은 PDF 최초 관측을 별도로 확인"
        },
        "available_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "검증된 다음 거래일 시가 시각; 달력 미연결 null"
        },
        "availability_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "보수적 가용시점 정책"
        },
        "post_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "원문 게시글 URL"
        },
        "attachment_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "공개 첨부 URL 목록; CSV에서는 JSON 문자열"
        },
        "embedded_image_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "게시물 내 이미지 URL; 이미지 내용 미수집"
        },
        "file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "실제 확인한 PDF 바이트 SHA-256; 미수집 null"
        },
        "file_hash_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "위 PDF 파일 해시를 실제 확인한 시각"
        },
        "pdf_current_version_verified": {
          "type": "boolean",
          "description": "최신 게시글 조회와 PDF 내용 재조회는 다름; 이번 감사 이후 false"
        },
        "document_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "내용 기반 sha256 버전; 이전 버전 덮어쓰기 금지"
        },
        "metadata_version": {
          "type": [
            "integer",
            "null"
          ],
          "description": "게시글 메타데이터 버전 정수"
        },
        "metadata_sha256": {
          "type": [
            "string",
            "null"
          ],
          "description": "안정적인 메타데이터 지문; 동적 스크립트 시각 제외"
        },
        "content_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "description": "게시글 표시 텍스트/이미지 URL 지문"
        },
        "identity_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "종목코드 외부 마스터 검증 상태"
        },
        "quality_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "검토·제외·메타데이터 상태"
        },
        "rights_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "원문 처리 이용허가 상태"
        },
        "training_eligible": {
          "type": "boolean",
          "description": "모든 품질/권리/시간 조건 통과 여부"
        },
        "inline_image_count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "본문 data: 이미지 수; 실제 이미지 내용은 저장하지 않음"
        },
        "inline_image_sha256": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "내장 이미지 변경 확인용 해시만 저장; 이미지 복원 불가"
        }
      },
      "required": [
        "report_id",
        "title",
        "post_url"
      ],
      "additionalProperties": true
    },
    "financial": {
      "type": "object",
      "properties": {
        "fact_id": {
          "type": [
            "string",
